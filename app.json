{
  "expo": {
    "name": "Qavora",
    "slug": "Qavora-Android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/qavora-icon-512.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.qavora.android",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0E1424",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/qavora-icon-512.png",
          "backgroundColor": "#181C28",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6f16f7df-809c-4705-af5a-80cb183ba8f5"
      }
    }
  }
}