# Qavora Android — Environment Configuration (Phase 1A & Phase 1B)
# Copy this file to `.env` and set the base URL of your running Qavora Web backend.
# Do not include a trailing slash.
#
# IMPORTANT: After editing `.env`, restart Expo with cache clearing so Metro
# picks up the updated `EXPO_PUBLIC_*` environment variables:
#   npx expo start -c
#
# Examples:
# - Deployed Qavora Backend (Vercel):        https://qavora-mongo-db-integrated.vercel.app
# - Local development (Web / iOS Simulator): http://localhost:3000
# - Android Emulator (host loopback):        http://10.0.2.2:3000
# - Physical Android Device (LAN IP):        http://192.168.1.100:3000
EXPO_PUBLIC_API_BASE_URL=https://qavora-mongo-db-integrated.vercel.app

# Trusted Origin header sent on native authentication & state-changing requests.
# Must match an origin permitted by the backend's `isOriginTrusted(origin)` check
# (for the deployed Vercel backend: https://qavora-mongo-db-integrated.vercel.app).
# Do not leave a stale localhost/LAN origin here when targeting the HTTPS production backend.
EXPO_PUBLIC_TRUSTED_ORIGIN=https://qavora-mongo-db-integrated.vercel.app

