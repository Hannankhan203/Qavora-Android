# Qavora Android — Environment Configuration (Phase 1A & Phase 1B)
# Copy this file to `.env` and set the base URL of your running Qavora Web backend.
# Do not include a trailing slash.
#
# Examples:
# - Local development (Web / iOS Simulator): http://localhost:3000
# - Android Emulator (host loopback):        http://10.0.2.2:3000
# - Physical Android Device (LAN IP):        http://192.168.1.100:3000
EXPO_PUBLIC_API_BASE_URL=

# Optional: Override the Origin header sent on native authentication & mutation requests
# if your backend's trusted APP_ORIGIN / PUBLIC_URL / CORS_ORIGIN differs from EXPO_PUBLIC_API_BASE_URL.
# When left blank, the origin is automatically derived from EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_TRUSTED_ORIGIN=
