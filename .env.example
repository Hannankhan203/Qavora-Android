# Qavora Android — Public Client Environment Configuration
#
# SECURITY NOTICE:
# All `EXPO_PUBLIC_*` variables are embedded into the client JavaScript bundle
# at build time and are publicly inspectable in the built app/APK/AAB.
# NEVER store API secrets, database URIs, signing keys, or credentials here.
#
# API Base URL Precedence (see src/services/apiClient.js -> getApiBaseUrl):
# 1. Explicit runtime `overrideBaseUrl` argument (highest precedence)
# 2. `EXPO_PUBLIC_API_BASE_URL` (primary environment variable)
# 3. `EXPO_PUBLIC_API_URL` (fallback environment variable when EXPO_PUBLIC_API_BASE_URL is unset/empty)
EXPO_PUBLIC_API_BASE_URL=https://qavora-mongo-db-integrated.vercel.app
EXPO_PUBLIC_API_URL=https://qavora-mongo-db-integrated.vercel.app

# Trusted Origin Header (see src/services/apiClient.js -> getTrustedOrigin):
# Optional explicit Origin sent for backend `isOriginTrusted` verification.
# Falls back to `EXPO_PUBLIC_APP_ORIGIN` or the origin of the effective API base URL.
EXPO_PUBLIC_TRUSTED_ORIGIN=https://qavora-mongo-db-integrated.vercel.app