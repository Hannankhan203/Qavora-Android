{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:3000",
        "EXPO_PUBLIC_TRUSTED_ORIGIN": "http://10.0.2.2:3000",
        "EXPO_PUBLIC_ALLOW_LOCAL_MOCK": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_ALLOW_LOCAL_MOCK": "false"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://qavora-mongo-db-integrated.vercel.app",
        "EXPO_PUBLIC_TRUSTED_ORIGIN": "https://qavora-mongo-db-integrated.vercel.app",
        "EXPO_PUBLIC_ALLOW_LOCAL_MOCK": "false"
      }
    }
  }
}
