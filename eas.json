{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://qavora-mongo-db-integrated.vercel.app",
        "EXPO_PUBLIC_TRUSTED_ORIGIN": "https://qavora-mongo-db-integrated.vercel.app"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://qavora-mongo-db-integrated.vercel.app",
        "EXPO_PUBLIC_TRUSTED_ORIGIN": "https://qavora-mongo-db-integrated.vercel.app"
      }
    }
  }
}
